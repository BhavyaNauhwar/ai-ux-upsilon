# ── AI Providers ─────────────────────────────────────────────────────────────
# Guest / free-tier model (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Paid / full-access model — can be the same key or a different Groq account
PAID_GROQ_API_KEY=your_paid_groq_api_key_here

# Gemini (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Active provider for paid users: gemini | groq-paid | openai | openrouter
AI_PROVIDER=groq-paid

# ── Supabase ──────────────────────────────────────────────────────────────────
# Connect your own Supabase project at https://supabase.com
# Run supabase_schema.sql in your project's SQL editor first.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
